{
  "name": "Airline_Analytics_Pipeline",
  "email_notifications": {},
  "webhook_notifications": {},
  "timeout_seconds": 3600,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "notebook_1_ingest_flights",
      "notebook_task": {
        "notebook_path": "/Workspace/Hexaware/notebook_1_ingest_flights",
        "source": "WORKSPACE"
      },
      "serverless": true,
      "retry_policy": {
        "max_retries": 2,
        "interval_seconds": 10,
        "on_failure_retry_behavior": "RETRY_ON_FAILURE"
      }
    },
    {
      "task_key": "notebook_2_ingest_bookings",
      "depends_on": [
        {
          "task_key": "notebook_1_ingest_flights"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Hexaware/notebook_2_ingest_bookings",
        "source": "WORKSPACE"
      },
      "serverless": true,
      "retry_policy": {
        "max_retries": 2,
        "interval_seconds": 10
      }
    },
    {
      "task_key": "notebook_3_transform_data",
      "depends_on": [
        {
          "task_key": "notebook_2_ingest_bookings"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Hexaware/notebook_3_transform_data",
        "source": "WORKSPACE"
      },
      "serverless": true,
      "retry_policy": {
        "max_retries": 1
      }
    },
    {
      "task_key": "notebook_4_generate_reports",
      "depends_on": [
        {
          "task_key": "notebook_3_transform_data"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Hexaware/notebook_4_generate_reports",
        "source": "WORKSPACE"
      },
      "serverless": true
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 8 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "UNPAUSED"
  }
}